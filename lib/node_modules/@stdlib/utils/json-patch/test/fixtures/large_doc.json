{
	"project": "stdlib-infra-registry",
	"version": "1.0.0",
	"metadata": {
		"owner": "devops@stdlib.io",
		"environment": "production",
		"region": "us-east-1",
		"tags": [ "core", "infrastructure", "telemetry" ],
		"sla": {
			"uptime": 99.99,
			"tier": "enterprise"
		}
	},
	"settings": {
		"theme": "dark",
		"debug": false,
		"allowed_ips": [
			"192.168.1.1",
			"10.0.0.1",
			"172.16.0.1"
		],
		"notifications": {
			"email": true,
			"sms": false,
			"webhook": {
				"url": "https://api.stdlib.io/v1/webhook",
				"retries": 3,
				"timeout_ms": 5000
			}
		},
		"deprecated_features": {
			"legacy_auth": true,
			"v1_api": false
		}
	},
	"cluster": {
		"region": "us-east-1",
