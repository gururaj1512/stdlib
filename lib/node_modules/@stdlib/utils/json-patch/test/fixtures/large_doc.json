				}
			},
			{
				"id": "node-003",
				"name": "worker-compute-02",
				"role": "worker",
				"status": "drain",
				"capacity": {
					"cpu": 32,
					"memory_gb": 128
				},
				"labels": {
					"topology.kubernetes.io/zone": "us-east-1c"
